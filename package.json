{
  "name": "go-viet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate-audio": "tsx scripts/generate-audio.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --disable-telemetry",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint -c oxlint.json --deny-warnings .",
    "lint:fix": "oxlint -c oxlint.json --fix .",
    "check:dead-code": "knip",
    "check:deps": "depcruise src --config .dependency-cruiser.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "commitlint": "commitlint",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:deps && npm run check:structure && npm run check:suppressions && npm run test:run && npm run check:dead-code && npm run build",
    "check:all": "npm run check && npm run check:audit && npm run build-storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.9.0",
    "jsdom": "^29.1.1",
    "knip": "^6.48.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
